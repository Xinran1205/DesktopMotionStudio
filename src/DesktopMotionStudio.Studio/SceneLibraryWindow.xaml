<Window x:Class="DesktopMotionStudio.Studio.SceneLibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopMotionStudio.Studio"
        Title="{loc:Text MotionLibrary2}" Width="1080" Height="760" MinWidth="860" MinHeight="580" WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
            <Button x:Name="HomeButton" Content="{loc:Text ReturnToMyAppsH}" AutomationProperties.Name="{loc:Text ReturnToMyApps}" DockPanel.Dock="Right" Click="OnHome"/>
            <StackPanel><TextBlock Text="{loc:Text MotionLibrary2}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{loc:Text ChooseACompleteWorkPreviewItAndBind}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <Button x:Name="RefreshButton" Content="{loc:Text Refresh3}" AutomationProperties.Name="{loc:Text RefreshMotionLibrary}" DockPanel.Dock="Right" Click="OnRefresh" Margin="12,0,0,0"/>
            <Button x:Name="ImportButton" Content="{loc:Text ImportMp4}" DockPanel.Dock="Right" Click="OnImport" Visibility="Collapsed" Margin="12,0,0,0"/>
            <Button x:Name="MotionDirectorButton" Content="{loc:Text MotionDirectorTitle}" DockPanel.Dock="Right" Click="OnMotionDirector" Visibility="Collapsed" Margin="12,0,0,0"/>
            <CheckBox x:Name="MyMotions" Content="{loc:Text MyMotions}" DockPanel.Dock="Left" Checked="OnSection" Unchecked="OnSection" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBox x:Name="SearchBox" AutomationProperties.Name="{loc:Text SearchWorks}" ToolTip="{loc:Text SearchByWorkName}" TextChanged="OnSearch"/>
        </DockPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid><ListBox x:Name="SceneList" AutomationProperties.Name="{loc:Text CompleteMotionWorks}" BorderThickness="0" Padding="8" HorizontalContentAlignment="Stretch" SelectionChanged="OnSelection">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,12"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="12" Margin="0,8,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox><TextBlock x:Name="EmptyText" Text="{loc:Text LoadingWorks}" Style="{StaticResource Caption}" Margin="22" TextAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <Border Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="12" Height="190"><Grid><TextBlock x:Name="FallbackMark" Text="M" FontSize="64" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="CoverImage" Stretch="Uniform" AutomationProperties.Name="{loc:Text WorkCover}"/></Grid></Border>
                    <TextBlock x:Name="SceneNameText" Text="{loc:Text ChooseAWork}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,8"/>
                    <TextBlock x:Name="PresentationText" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="DescriptionText" Text="{loc:Text ChooseAWorkOnTheLeftToSee}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <TextBlock x:Name="AvailabilityText" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <WrapPanel><Button x:Name="PreviewButton" Content="{loc:Text PreviewWork}" AutomationProperties.Name="{loc:Text PreviewWork2}" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource AccessButtonContent}" Click="OnPreview" IsEnabled="False"/><Button x:Name="BindButton" Content="{loc:Text BindToApp}" AutomationProperties.Name="{loc:Text BindToApp2}" Click="OnBind" IsEnabled="False"/></WrapPanel>
                    <WrapPanel x:Name="ManageImport" Visibility="Collapsed" Margin="0,10,0,0">
                        <Button Content="{loc:Text EditImport}" Click="OnEditImport"/>
                        <Button Content="{loc:Text RemoveImport}" Click="OnRemoveImport"/>
                    </WrapPanel>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,16,0,0"><Button x:Name="StopPreviewButton" Content="{loc:Text StopPreview}" AutomationProperties.Name="{loc:Text StopPreview}" Click="OnStop" DockPanel.Dock="Right"/><TextBlock x:Name="PreviewStatusText" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel>
        <TextBlock Grid.Row="4" x:Name="StatusText" Style="{StaticResource Caption}" AutomationProperties.AutomationId="LibraryStatus" Margin="0,12,0,0"/>
    </Grid>
</Window>
