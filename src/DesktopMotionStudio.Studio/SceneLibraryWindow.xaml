<Window x:Class="DesktopMotionStudio.Studio.SceneLibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="动效作品库" Width="1080" Height="760" MinWidth="860" MinHeight="580" WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
            <Button x:Name="HomeButton" Content="返回我的应用(_H)" AutomationProperties.Name="返回我的应用" DockPanel.Dock="Right" Click="OnHome"/>
            <StackPanel><TextBlock Text="动效作品库" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="选择完整作品，预览后为应用设置动效。" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <Button x:Name="RefreshButton" Content="刷新(_R)" AutomationProperties.Name="刷新作品库" DockPanel.Dock="Right" Click="OnRefresh" Margin="12,0,0,0"/>
            <TextBox x:Name="SearchBox" AutomationProperties.Name="搜索作品" ToolTip="按作品名称搜索" TextChanged="OnSearch"/>
        </DockPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid><ListBox x:Name="SceneList" AutomationProperties.Name="完整动效作品" BorderThickness="0" Padding="8" HorizontalContentAlignment="Stretch" SelectionChanged="OnSelection">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,12"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="12" Margin="0,8,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox><TextBlock x:Name="EmptyText" Text="正在读取作品…" Style="{StaticResource Caption}" Margin="22" TextAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <Border Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="12" Height="190"><Grid><TextBlock x:Name="FallbackMark" Text="M" FontSize="64" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="CoverImage" Stretch="Uniform" AutomationProperties.Name="作品封面"/></Grid></Border>
                    <TextBlock x:Name="SceneNameText" Text="请选择作品" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,8"/>
                    <TextBlock x:Name="PresentationText" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="DescriptionText" Text="从左侧选择作品查看详情。" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <TextBlock x:Name="AvailabilityText" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <WrapPanel><Button x:Name="PreviewButton" Content="预览作品(_P)" AutomationProperties.Name="预览作品" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource AccessButtonContent}" Click="OnPreview" IsEnabled="False"/><Button x:Name="BindButton" Content="绑定到应用(_B)" AutomationProperties.Name="绑定到应用" Click="OnBind" IsEnabled="False"/></WrapPanel>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,16,0,0"><Button x:Name="StopPreviewButton" Content="停止预览" AutomationProperties.Name="停止预览" Click="OnStop" DockPanel.Dock="Right"/><TextBlock x:Name="PreviewStatusText" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel>
        <TextBlock Grid.Row="4" x:Name="StatusText" Style="{StaticResource Caption}" AutomationProperties.AutomationId="LibraryStatus" Margin="0,12,0,0"/>
    </Grid>
</Window>
