<Window x:Class="DesktopMotionStudio.Studio.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18" />
        <Label Content="主题(_T)" Target="{Binding ElementName=ThemeBox}" Padding="0,0,0,6" />
        <ComboBox x:Name="ThemeBox" AutomationProperties.Name="主题" IsEnabled="False">
            <ComboBoxItem Content="跟随系统" Tag="system" />
            <ComboBoxItem Content="浅色" Tag="light" />
            <ComboBoxItem Content="深色" Tag="dark" />
        </ComboBox>
        <CheckBox x:Name="MuteBox" Content="全局静音(_M)" AutomationProperties.Name="全局静音" Margin="0,18,0,4" IsEnabled="False" />
        <TextBlock Text="当前内置作品没有音频。静音偏好会保留。" Style="{StaticResource Caption}" />
        <TextBlock x:Name="PreferenceStatus" Text="正在读取设置…" Style="{StaticResource Caption}"
                   AutomationProperties.AutomationId="PreferenceStatus" Margin="0,14,0,14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消" AutomationProperties.Name="取消设置" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="保存(_S)" AutomationProperties.Name="保存设置" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource AccessButtonContent}"
                    IsDefault="True" IsEnabled="False" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
