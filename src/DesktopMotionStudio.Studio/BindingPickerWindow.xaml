<Window x:Class="DesktopMotionStudio.Studio.BindingPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopMotionStudio.Studio"
        Title="{loc:Text BindMotionToAnApp}" Width="720" Height="660" MinWidth="620" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock Text="{loc:Text ChooseASavedApp}" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="SceneText" Style="{StaticResource Caption}" Margin="0,8,0,0"/><TextBlock Text="{loc:Text YouCanBindAWorkToSeveralApps}" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,14"><Button x:Name="RefreshButton" Content="{loc:Text Refresh}" AutomationProperties.Name="{loc:Text RefreshAppsForBinding}" Click="OnRefresh" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBox x:Name="SearchBox" AutomationProperties.Name="{loc:Text SearchAppsToBind}" TextChanged="OnSearch"/></DockPanel>
        <Grid Grid.Row="2"><ListBox x:Name="BindingAppsList" AutomationProperties.Name="{loc:Text SavedAppsAvailableForBinding}" SelectionChanged="OnSelection" HorizontalContentAlignment="Stretch" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="14,12"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox><TextBlock x:Name="EmptyText" Text="{loc:Text NoAppsAddedAddAnAppAndConfirm}" Style="{StaticResource Caption}" TextAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False"/></Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource Caption}" AutomationProperties.AutomationId="BindingStatus" Margin="0,16,0,16"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="{loc:Text Cancel}" AutomationProperties.Name="{loc:Text CancelBinding}" IsCancel="True"/><Button x:Name="SaveButton" Content="{loc:Text SaveBinding}" AutomationProperties.Name="{loc:Text ConfirmBinding}" IsEnabled="False" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource AccessButtonContent}" Click="OnSave"/></StackPanel>
    </Grid>
</Window>
