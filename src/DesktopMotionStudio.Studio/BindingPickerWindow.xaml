<Window x:Class="DesktopMotionStudio.Studio.BindingPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="绑定动效到应用" Width="720" Height="660" MinWidth="620" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock Text="选择已保存的应用" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="SceneText" Style="{StaticResource Caption}" Margin="0,8,0,0"/><TextBlock Text="同一作品可绑定多个应用；替换会保留此应用的绑定身份。" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,14"><Button x:Name="RefreshButton" Content="刷新" AutomationProperties.Name="刷新绑定应用" Click="OnRefresh" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBox x:Name="SearchBox" AutomationProperties.Name="搜索绑定应用" TextChanged="OnSearch"/></DockPanel>
        <Grid Grid.Row="2"><ListBox x:Name="BindingAppsList" AutomationProperties.Name="可选择的已保存应用" SelectionChanged="OnSelection" HorizontalContentAlignment="Stretch" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="14,12"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox><TextBlock x:Name="EmptyText" Text="尚未添加应用。&#10;返回我的应用添加并确认入口后，再来绑定。" Style="{StaticResource Caption}" TextAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False"/></Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource Caption}" AutomationProperties.AutomationId="BindingStatus" Margin="0,16,0,16"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="取消" AutomationProperties.Name="取消绑定" IsCancel="True"/><Button x:Name="SaveButton" Content="确认绑定(_S)" AutomationProperties.Name="确认绑定" IsEnabled="False" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource AccessButtonContent}" Click="OnSave"/></StackPanel>
    </Grid>
</Window>
