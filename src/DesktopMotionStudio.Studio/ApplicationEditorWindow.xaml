<Window x:Class="DesktopMotionStudio.Studio.ApplicationEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopMotionStudio.Studio"
        Title="{loc:Text AddApp}" Width="820" Height="700" MinWidth="660" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock x:Name="Heading" Text="{loc:Text AddApp}" FontSize="25" FontWeight="SemiBold" /><TextBlock x:Name="Intro" Text="{loc:Text ChooseALocalEntryOrSelectAnApp}" Style="{StaticResource Caption}" Margin="0,8,0,0" /></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,16"><Label Content="{loc:Text DisplayName}" Target="{Binding ElementName=DisplayNameBox}" Padding="0,0,0,5" /><TextBox x:Name="DisplayNameBox" AutomationProperties.Name="{loc:Text DisplayName2}" MaxLength="120" /></StackPanel>
        <TabControl Grid.Row="2" x:Name="SourceTabs" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16">
            <TabItem Header="{loc:Text LocalFile}" AutomationProperties.Name="{loc:Text LocalFile}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,10">
                    <Label Content="{loc:Text EntryType}" Target="{Binding ElementName=KindBox}" Padding="0,0,0,5" />
                    <ComboBox x:Name="KindBox" SelectedIndex="0" AutomationProperties.Name="{loc:Text EntryType2}" SelectionChanged="OnKindChanged"><ComboBoxItem Content="{loc:Text ProgramExe}" /><ComboBoxItem Content="{loc:Text ShortcutLnk}" /></ComboBox>
                    <Label Content="{loc:Text ApplicationPath}" Target="{Binding ElementName=PathBox}" Padding="0,18,0,5" />
                    <DockPanel><Button DockPanel.Dock="Right" Content="{loc:Text Browse}" AutomationProperties.Name="{loc:Text BrowseApplicationFiles}" Margin="10,0,0,0" Click="OnBrowse" /><TextBox x:Name="PathBox" AutomationProperties.Name="{loc:Text ApplicationPath2}" /></DockPanel>
                    <TextBlock Text="{loc:Text AddingAnAppSavesItsLaunchEntry}" Style="{StaticResource Caption}" FontSize="12" Margin="0,10,0,18" />
                    <Expander x:Name="Advanced" Header="{loc:Text AdvancedLaunchOptions}" IsExpanded="False"><StackPanel Margin="0,12,0,0">
                        <Label Content="{loc:Text LaunchArgumentsOnePerLineSavedAsEntered}" Target="{Binding ElementName=ArgumentsBox}" Padding="0,0,0,5" />
                        <TextBox x:Name="ArgumentsBox" AutomationProperties.Name="{loc:Text LaunchArguments}" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                        <Label Content="{loc:Text WorkingDirectoryOptional}" Target="{Binding ElementName=WorkingDirectoryBox}" Padding="0,12,0,5" />
                        <TextBox x:Name="WorkingDirectoryBox" AutomationProperties.Name="{loc:Text WorkingDirectory}" />
                    </StackPanel></Expander>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Text InstalledApps}" AutomationProperties.Name="{loc:Text InstalledApps}">
                <Grid Margin="2,10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel><Button DockPanel.Dock="Right" Content="{loc:Text Rescan}" AutomationProperties.Name="{loc:Text RescanInstalledApps}" Margin="10,0,0,0" Click="OnDiscover" /><TextBox x:Name="DiscoverySearchBox" AutomationProperties.Name="{loc:Text SearchInstalledApps}" TextChanged="OnDiscoverySearch" /></DockPanel>
                    <TextBlock Grid.Row="1" x:Name="DiscoveryStatusText" Text="{loc:Text LookingForLocalApps}" Style="{StaticResource Caption}" Margin="0,10,0,12" />
                    <ListBox Grid.Row="2" x:Name="DiscoveryList" AutomationProperties.Name="{loc:Text DiscoveredApps}" HorizontalContentAlignment="Stretch" SelectionChanged="OnCandidateSelected">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" /></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Target.Identifier}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" x:Name="StatusText" Style="{StaticResource Caption}" AutomationProperties.AutomationId="SaveStatus" Margin="0,16,0,16" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="{loc:Text Cancel}" AutomationProperties.Name="{loc:Text CancelAddingApp}" IsCancel="True" />
            <Button x:Name="SaveButton" Content="{loc:Text SaveApp}" AutomationProperties.Name="{loc:Text SaveApp2}" IsDefault="True" Margin="0" Style="{DynamicResource AccentButtonStyle}" ContentTemplate="{StaticResource AccessButtonContent}" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
