<Window x:Class="DesktopMotionStudio.Studio.ApplicationEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加应用" Width="820" Height="700" MinWidth="660" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock x:Name="Heading" Text="添加应用" FontSize="25" FontWeight="SemiBold" /><TextBlock x:Name="Intro" Text="选择本地入口，或从此设备的应用列表中添加。" Style="{StaticResource Caption}" Margin="0,8,0,0" /></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,16"><Label Content="显示名称(_N)" Target="{Binding ElementName=DisplayNameBox}" Padding="0,0,0,5" /><TextBox x:Name="DisplayNameBox" AutomationProperties.Name="显示名称" MaxLength="120" /></StackPanel>
        <TabControl Grid.Row="2" x:Name="SourceTabs" Background="White" BorderBrush="#DAE1EF" Padding="16">
            <TabItem Header="本地文件" AutomationProperties.Name="本地文件">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,10">
                    <Label Content="入口类型(_T)" Target="{Binding ElementName=KindBox}" Padding="0,0,0,5" />
                    <ComboBox x:Name="KindBox" SelectedIndex="0" AutomationProperties.Name="入口类型" SelectionChanged="OnKindChanged"><ComboBoxItem Content="程序 (.exe)" /><ComboBoxItem Content="快捷方式 (.lnk)" /></ComboBox>
                    <Label Content="应用路径(_P)" Target="{Binding ElementName=PathBox}" Padding="0,18,0,5" />
                    <DockPanel><Button DockPanel.Dock="Right" Content="浏览…" AutomationProperties.Name="浏览应用文件" Margin="10,0,0,0" Click="OnBrowse" /><TextBox x:Name="PathBox" AutomationProperties.Name="应用路径" /></DockPanel>
                    <TextBlock Text="添加只保存启动入口，不会运行所选应用。" Style="{StaticResource Caption}" FontSize="12" Margin="0,10,0,18" />
                    <Expander x:Name="Advanced" Header="高级启动选项" IsExpanded="False"><StackPanel Margin="0,12,0,0">
                        <Label Content="启动参数（每行一个，按原样保存）" Target="{Binding ElementName=ArgumentsBox}" Padding="0,0,0,5" />
                        <TextBox x:Name="ArgumentsBox" AutomationProperties.Name="启动参数" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                        <Label Content="工作目录（可选）" Target="{Binding ElementName=WorkingDirectoryBox}" Padding="0,12,0,5" />
                        <TextBox x:Name="WorkingDirectoryBox" AutomationProperties.Name="工作目录" />
                    </StackPanel></Expander>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="已安装应用" AutomationProperties.Name="已安装应用">
                <Grid Margin="2,10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel><Button DockPanel.Dock="Right" Content="重新发现" AutomationProperties.Name="重新发现应用" Margin="10,0,0,0" Click="OnDiscover" /><TextBox x:Name="DiscoverySearchBox" AutomationProperties.Name="搜索已安装应用" TextChanged="OnDiscoverySearch" /></DockPanel>
                    <TextBlock Grid.Row="1" x:Name="DiscoveryStatusText" Text="正在发现本地应用…" Style="{StaticResource Caption}" Margin="0,10,0,12" />
                    <ListBox Grid.Row="2" x:Name="DiscoveryList" AutomationProperties.Name="发现的应用" HorizontalContentAlignment="Stretch" SelectionChanged="OnCandidateSelected">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" /></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Target.Identifier}" FontSize="12" Foreground="#65728A" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" x:Name="StatusText" Style="{StaticResource Caption}" AutomationProperties.AutomationId="SaveStatus" Margin="0,16,0,16" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消" AutomationProperties.Name="取消添加" IsCancel="True" />
            <Button x:Name="SaveButton" Content="保存应用(_S)" AutomationProperties.Name="保存应用" IsDefault="True" Margin="0" Style="{StaticResource PrimaryButton}" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
