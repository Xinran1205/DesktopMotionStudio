<Window x:Class="DesktopMotionStudio.Studio.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本地诊断" Width="740" Height="610" MinWidth="560" MinHeight="470" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="本地诊断" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="ComponentsText" AutomationProperties.AutomationId="DiagnosticComponents" Style="{StaticResource Caption}" Margin="0,8,0,4" />
            <TextBlock x:Name="CapabilityText" Style="{StaticResource Caption}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="最近启动结果" FontWeight="SemiBold" />
            <TextBlock x:Name="DiagnosticStatusText" Text="正在读取诊断…" Style="{StaticResource Caption}" Margin="0,6,0,0"
                       AutomationProperties.AutomationId="DiagnosticStatus" />
        </StackPanel>
        <TextBox Grid.Row="2" x:Name="RecentEventsText" AutomationProperties.Name="最近诊断记录"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="3" Margin="0,14,0,12">
            <TextBlock Text="所选应用的桌面入口" FontWeight="SemiBold" />
            <TextBlock x:Name="EntryStatusText" AutomationProperties.AutomationId="DiagnosticEntry" Style="{StaticResource Caption}" Margin="0,6,0,6" />
            <Button x:Name="RepairEntryButton" Content="修复入口(_R)" AutomationProperties.Name="诊断修复入口" Click="OnRepair" IsEnabled="False" />
            <TextBlock x:Name="RepairResultText" Style="{StaticResource Caption}" Margin="0,6,0,0" />
        </StackPanel>
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
            <Button x:Name="RefreshButton" Content="刷新(_F)" AutomationProperties.Name="刷新诊断" Margin="0,0,8,0" Click="OnRefresh" />
            <Button x:Name="OpenLogsButton" Content="打开日志目录(_O)" AutomationProperties.Name="打开日志目录" Margin="0,0,8,0" Click="OnOpen" IsEnabled="False" />
            <Button x:Name="CopyReportButton" Content="复制摘要(_C)" AutomationProperties.Name="复制诊断摘要" Margin="0,0,8,0" Click="OnCopy" IsEnabled="False" />
            <Button x:Name="CloseButton" Content="关闭" AutomationProperties.Name="关闭诊断" IsCancel="True" />
        </WrapPanel>
    </Grid>
</Window>
