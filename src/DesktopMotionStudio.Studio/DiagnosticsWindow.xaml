<Window x:Class="DesktopMotionStudio.Studio.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopMotionStudio.Studio"
        Title="{loc:Text LocalDiagnostics}" Width="740" Height="610" MinWidth="560" MinHeight="470" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{loc:Text LocalDiagnostics}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="ComponentsText" AutomationProperties.AutomationId="DiagnosticComponents" Style="{StaticResource Caption}" Margin="0,8,0,4" />
            <TextBlock x:Name="CapabilityText" Style="{StaticResource Caption}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{loc:Text LatestLaunchResult}" FontWeight="SemiBold" />
            <TextBlock x:Name="DiagnosticStatusText" Text="{loc:Text LoadingDiagnostics}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                       AutomationProperties.AutomationId="DiagnosticStatus" />
        </StackPanel>
        <TextBox Grid.Row="2" x:Name="RecentEventsText" AutomationProperties.Name="{loc:Text RecentDiagnosticRecords}"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="3" Margin="0,14,0,12">
            <TextBlock Text="{loc:Text DesktopShortcutForTheSelectedApp}" FontWeight="SemiBold" />
            <TextBlock x:Name="EntryStatusText" AutomationProperties.AutomationId="DiagnosticEntry" Style="{StaticResource Caption}" Margin="0,6,0,6" />
            <Button x:Name="RepairEntryButton" Content="{loc:Text RepairShortcut}" AutomationProperties.Name="{loc:Text RepairShortcutFromDiagnostics}" Click="OnRepair" IsEnabled="False" />
            <TextBlock x:Name="RepairResultText" Style="{StaticResource Caption}" Margin="0,6,0,0" />
        </StackPanel>
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
            <Button x:Name="RefreshButton" Content="{loc:Text Refresh2}" AutomationProperties.Name="{loc:Text RefreshDiagnostics}" Margin="0,0,8,0" Click="OnRefresh" />
            <Button x:Name="OpenLogsButton" Content="{loc:Text OpenLogFolder}" AutomationProperties.Name="{loc:Text OpenLogFolder2}" Margin="0,0,8,0" Click="OnOpen" IsEnabled="False" />
            <Button x:Name="CopyReportButton" Content="{loc:Text CopySummary}" AutomationProperties.Name="{loc:Text CopyDiagnosticSummary}" Margin="0,0,8,0" Click="OnCopy" IsEnabled="False" />
            <Button x:Name="CloseButton" Content="{loc:Text Close}" AutomationProperties.Name="{loc:Text CloseDiagnostics}" IsCancel="True" />
        </WrapPanel>
    </Grid>
</Window>
